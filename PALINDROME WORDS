#include <stdio.h>

int main() {
    char words[100];
    int count = 0;

    printf("Enter a word: ");
    scanf("%s", words);

    while (words[count] != '\0') {
        count++;
    }

    //From original
    printf("Original ==> ");
    int i = 0;
    while (i < count) {
        printf("%c", words[i]);
        i++;
    }
    printf("\n");

    //To reverse
    printf("Reverse  ==> ");
    i = count - 1;
    while (i >= 0) {
        printf("%c", words[i]);
        i--;
    }
    printf("\n");

    // Check if palindrome
    int palindrome = 1;
    int head = 0;
    int tail = count - 1;
    while (head < tail) {
        if (words[head] != words[tail]) { 
            palindrome = 0;
            break;
        }
        head++;
        tail--;
    }

    if (palindrome) {
        printf("\nPalindrome!!\n");
    } else {
        printf("\nNot Palindrome\n");
    }

    return 0;
}
